{
  "name": "grudge-galaxies",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Grudge Galaxies browser MMO: three.js r185 + Rapier client, built with Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prefabs:bake": "node tools/prefab_bake.mjs",
    "prefabs:verify": "node tools/prefab_bake.mjs --verify",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "meshoptimizer": "1.1.1",
    "three": "0.185.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/three": "0.185.4",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "^3.2.4"
  }
}
